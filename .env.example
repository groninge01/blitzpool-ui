# Example configuration for the blitzpool-ui container.
# Copy to .env and adjust — .env is gitignored and loaded by
# docker compose automatically (interpolation) and into the container
# via `env_file` (docker/entrypoint.sh writes BLITZPOOL_* values into
# assets/runtime-config.js at container start).
#
# Apply changes with: docker compose up -d

# Host port the UI listens on (container port is always 80).
# UI_PORT=8080

# In-network upstream for the /api reverse proxy.
# API_UPSTREAM=blitzpool-api:3334

# Caddy access-log verbosity/format: DEBUG|INFO|WARN|ERROR, json|console.
# LOGLEVEL=INFO
# LOGFORMAT=json

# --- Runtime overrides (shown/used by the web UI) ---

# Stratum endpoints advertised on the home page, as miners reach them.
# BLITZPOOL_STRATUM_URL=pool.example.com:3333
# BLITZPOOL_STRATUM_V2_URL=pool.example.com:23330
# SV2 authority public key miners need for the Noise handshake.
# BLITZPOOL_STRATUM_V2_PUBKEY=

# PPLNS endpoints (shown only when the pool runs in PPLNS mode).
# BLITZPOOL_PPLNS_STRATUM_URL=
# BLITZPOOL_PPLNS_STRATUM_V2_URL=
# BLITZPOOL_PPLNS_DATUM_URL=

# Browser-facing base URL for the API. Normally left unset — the
# same-origin /api reverse proxy handles it. Set only if browsers
# should call the API directly at a different origin.
# BLITZPOOL_API_URL=
